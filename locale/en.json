      "published": "Knowledge published successfully",
      "publishFailed": "Failed to publish knowledge",
      "queryFailed": "Failed to query knowledge"
    }
  },
  "tools": {
    "fishSchoolPublish": {
      "name": "fish_school_publish",
      "description": "Summarize and publish knowledge to the fish school network for other instances to access",
